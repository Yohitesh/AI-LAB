class Node:
    def __init__(self, name):
        self.name = name
        self.children = []

    def add_child(self, child_node):
        self.children.append(child_node)

    def __repr__(self):
        return self.name

def depth_limited_search(node, goal, limit, path):
    """
    Performs a Depth-Limited Search (DLS) from the given node.
    """
    path.append(node.name)

    if node.name == goal:
        return path

    if limit == 0:
        path.pop() # Backtrack
        return None

    for child in node.children:
        result = depth_limited_search(child, goal, limit - 1, path)
        if result:
            return result
    
    path.pop() # Backtrack
    return None

def iterative_deepening_dfs(root, goal, max_depth=10):
    """
    Performs an Iterative Deepening Depth-First Search (IDDFS).
    """
    for depth in range(max_depth + 1):
        print(f"Searching with depth limit: {depth}")
        path = []
        result = depth_limited_search(root, goal, depth, path)
        if result:
            return result
    return None

